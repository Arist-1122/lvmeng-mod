diff --git a/source/d3d12/d3d12_ia_snapshot.inl b/source/d3d12/d3d12_ia_snapshot.inl
new file mode 100644
index 0000000..cb6ece7
--- /dev/null
+++ b/source/d3d12/d3d12_ia_snapshot.inl
@@ -0,0 +1,53 @@
+// Included once by d3d12_impl_command_list.cpp. No addon callbacks are emitted by
+// exact binding. Callers serialize native recording and own every resource.
+uint64_t reshade::d3d12::command_list_impl::next_ia_generation()
+{
+    static std::atomic<uint64_t> sequence { 1 };
+    auto value = sequence.load(std::memory_order_relaxed);
+    while (value != UINT64_MAX)
+        if (sequence.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) return value;
+    return 0; // Permanent exhaustion, never recycle a recording generation.
+}
+bool reshade::d3d12::command_list_impl::query_ia_snapshot(uint32_t mask, uint32_t require_index, rs_ia_snapshot_v1 *out) const
+{
+    return _ia_state.query(mask, require_index, out);
+}
+bool reshade::d3d12::command_list_impl::bind_ia_views(const rs_ia_binding_v1 &binding)
+{
+    static_assert(sizeof(rs_vertex_buffer_view_v1) == sizeof(D3D12_VERTEX_BUFFER_VIEW));
+    static_assert(sizeof(rs_index_buffer_view_v1) == sizeof(D3D12_INDEX_BUFFER_VIEW));
+    if (binding.size != sizeof(binding) || binding.version != 1 ||
+        binding.first_vertex_slot > 32 || binding.vertex_count > 32 - binding.first_vertex_slot ||
+        binding.bind_index > 1 || binding.index_present > 1 || !binding.expected_recording_generation)
+        return false;
+    if (!binding.vertex_count && !binding.bind_index)
+        return _ia_state.generation_matches(binding.expected_recording_generation);
+
+    // Own bounded value copy, not a retained caller pointer or resource reference.
+    const rs_ia_binding_v1 values = binding;
+    D3D12_VERTEX_BUFFER_VIEW native_views[32] = {};
+    D3D12_INDEX_BUFFER_VIEW native_index = {};
+    std::memcpy(native_views, values.vertex, values.vertex_count * sizeof(native_views[0]));
+    std::memcpy(&native_index, &values.index, sizeof(native_index));
+    auto mutation = _ia_state.begin(values.first_vertex_slot, values.vertex_count, values.vertex,
+        values.bind_index != 0, values.index_present != 0, &values.index,
+        values.expected_recording_generation, true);
+    if (!mutation.started()) return false;
+    if (values.vertex_count) _orig->IASetVertexBuffers(values.first_vertex_slot, values.vertex_count, native_views);
+    if (values.bind_index) _orig->IASetIndexBuffer(values.index_present ? &native_index : nullptr);
+    return _ia_state.finish(mutation);
+}
+extern "C" __declspec(dllexport) bool ReShadeD3D12QueryIASnapshotV1(void *api_command_list, uint32_t required_vertex_mask, uint32_t require_index, rs_ia_snapshot_v1 *out)
+{
+    if (!api_command_list || !out || out->size != sizeof(*out) || out->version != 1 || require_index > 1) return false;
+    auto *api_base = static_cast<reshade::api::command_list *>(api_command_list);
+    if (api_base->get_device()->get_api() != reshade::api::device_api::d3d12) return false;
+    return static_cast<reshade::d3d12::command_list_impl *>(api_base)->query_ia_snapshot(required_vertex_mask, require_index, out);
+}
+extern "C" __declspec(dllexport) bool ReShadeD3D12BindIAViewsV1(void *api_command_list, const rs_ia_binding_v1 *binding)
+{
+    if (!api_command_list || !binding || binding->size != sizeof(*binding) || binding->version != 1) return false;
+    auto *api_base = static_cast<reshade::api::command_list *>(api_command_list);
+    if (api_base->get_device()->get_api() != reshade::api::device_api::d3d12) return false;
+    return static_cast<reshade::d3d12::command_list_impl *>(api_base)->bind_ia_views(*binding);
+}
