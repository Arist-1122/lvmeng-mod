+extern "C" __declspec(dllexport) bool ReShadeD3D12QueryDescriptorMetadataV1(void *api_device, uint64_t table, uint32_t binding, uint32_t array_offset, rs_descriptor_metadata_v1 *out)
+{
+    if (!api_device || !out || out->size != sizeof(*out) || out->version != 1) return false;
+    // Caller owns the API device lifetime; honor base-subobject adjustment.
+    auto *api_base = static_cast<reshade::api::device *>(api_device);
+    if (api_base->get_api() != reshade::api::device_api::d3d12) return false;
+    auto *device = static_cast<reshade::d3d12::device_impl *>(api_base);
+    return device->query_descriptor_metadata(table, binding, array_offset, out);
+}
