@@ -0,0 +1,69 @@
+#pragma once
+#include "ia_snapshot_v1.h"
+#include <mutex>
+#include <cstring>
+
+namespace reshade::d3d12 {
+// Fixed storage only. Native operations/callbacks occur between begin and finish,
+// never under this mutex. The mutex does not legalize concurrent D3D12 recording.
+class ia_state_store {
+ mutable std::mutex mutex;
+ bool enabled=false,recording=false,poisoned=false,destroyed=false;
+ uint32_t type=0,known=0,active=0;bool ib_known=false,ib_present=false;
+ uint64_t generation=0,epoch=0;
+ rs_vertex_buffer_view_v1 vb[32]={};rs_index_buffer_view_v1 ib={};
+ void unknown(){known=0;ib_known=ib_present=false;std::memset(vb,0,sizeof(vb));ib={};}
+ bool advance(){if(epoch==UINT64_MAX){poisoned=true;unknown();return false;}++epoch;return true;}
+ static uint32_t mask(uint32_t first,uint32_t count){return !count?0:count==32?UINT32_MAX:((uint32_t(1)<<count)-1)<<first;}
+public:
+ struct operation {
+  ia_state_store *owner=nullptr;uint64_t generation=0,token=0;
+  uint32_t first=0,count=0;bool bind_ib=false,present=false,reset=false,unknown_only=false;
+  rs_vertex_buffer_view_v1 values[32]={};rs_index_buffer_view_v1 index={};
+  operation()=default;operation(const operation&)=delete;operation&operator=(const operation&)=delete;
+  operation(operation&&o) noexcept:owner(o.owner),generation(o.generation),token(o.token),first(o.first),count(o.count),bind_ib(o.bind_ib),present(o.present),reset(o.reset),unknown_only(o.unknown_only),index(o.index){std::memcpy(values,o.values,sizeof(values));o.owner=nullptr;}
+  ~operation(){if(owner)owner->finish(*this,false);}
+  bool started()const{return owner!=nullptr;}
+ };
+ void enable(uint32_t list_type,uint64_t gen){std::lock_guard<std::mutex>l(mutex);type=list_type;enabled=list_type==0&&gen!=0;recording=enabled;generation=gen;advance();unknown();}
+ operation begin(uint32_t first,uint32_t count,const rs_vertex_buffer_view_v1 *views,bool bind_ib,bool present,const rs_index_buffer_view_v1 *index,uint64_t expected=0,bool strict=false){
+  std::lock_guard<std::mutex>l(mutex);operation tx;
+  if(!enabled||!recording||destroyed)return tx;
+  if(first>32||count>32-first||(present&&bind_ib&&!index)){poisoned=true;unknown();advance();return tx;}
+  if(strict&&(!expected||expected!=generation||active||poisoned))return tx;
+  if(!count&&!bind_ib)return tx;
+  if(active){poisoned=true;unknown();}if(!advance())return tx;
+  tx.owner=this;tx.generation=generation;tx.token=epoch;tx.first=first;tx.count=count;tx.bind_ib=bind_ib;tx.present=present;
+  if(views)std::memcpy(tx.values,views,count*sizeof(*views));if(bind_ib&&present)tx.index=*index;
+  known&=~mask(first,count);for(uint32_t i=0;i<count;i++)vb[first+i]={};if(bind_ib){ib_known=ib_present=false;ib={};}++active;return tx;
+ }
+ operation begin_reset(uint64_t gen){
+  std::lock_guard<std::mutex>l(mutex);operation tx;if(!enabled||destroyed)return tx;
+  bool overlap=active!=0;unknown();recording=false;poisoned=overlap||!gen;generation=gen;if(!advance())return tx;
+  tx.owner=this;tx.generation=gen;tx.token=epoch;tx.reset=true;++active;return tx;
+ }
+ operation begin_unknown(){std::lock_guard<std::mutex>l(mutex);operation tx;if(!enabled||!recording||destroyed)return tx;unknown();if(active)poisoned=true;if(!advance())return tx;tx.owner=this;tx.generation=generation;tx.token=epoch;tx.unknown_only=true;++active;return tx;}
+ bool finish(operation &tx,bool native_returned=true){
+  std::lock_guard<std::mutex>l(mutex);if(tx.owner!=this)return false;
+  const bool same=tx.generation==generation;bool commit=native_returned&&same&&!destroyed&&!poisoned&&active==1&&tx.token==epoch;
+  if(same){
+   if(tx.reset){recording=commit;unknown();}
+   else if(tx.unknown_only)unknown();
+   else if(commit&&recording){for(uint32_t i=0;i<tx.count;i++)vb[tx.first+i]=tx.values[i];known|=mask(tx.first,tx.count);if(tx.bind_ib){ib_known=true;ib_present=tx.present;ib=tx.index;}}
+   else{unknown();if(active>1)poisoned=true;}
+  }
+  advance();if(active)--active;tx.owner=nullptr;return commit;
+ }
+ void invalidate(){std::lock_guard<std::mutex>l(mutex);unknown();advance();}
+ void close(){std::lock_guard<std::mutex>l(mutex);recording=false;unknown();advance();}
+ void destroy(){std::lock_guard<std::mutex>l(mutex);destroyed=true;recording=false;unknown();advance();}
+ bool generation_matches(uint64_t gen)const{std::lock_guard<std::mutex>l(mutex);return enabled&&recording&&!destroyed&&!active&&!poisoned&&gen&&generation==gen;}
+ bool query(uint32_t required,uint32_t require_ib,rs_ia_snapshot_v1*out)const{
+  if(!out||out->size!=sizeof(*out)||out->version!=1||require_ib>1)return false;std::lock_guard<std::mutex>l(mutex);
+  rs_ia_snapshot_v1 r={};r.size=sizeof(r);r.version=1;r.command_list_type=type;r.recording_generation=generation;r.mutation_epoch=epoch;
+  if(!enabled)r.status=rs_ia_unsupported;else if(destroyed)r.status=rs_ia_destroyed;else if(active)r.status=rs_ia_busy;else if(!recording)r.status=rs_ia_closed;else if(poisoned)r.status=rs_ia_invalid;
+  else{r.vertex_known_mask=known;r.index_known=ib_known;r.index_present=ib_present;std::memcpy(r.vertex,vb,sizeof(vb));r.index=ib;r.status=(known&required)==required&&(!require_ib||ib_known)?rs_ia_complete:rs_ia_partial;}
+  *out=r;return true;
+ }
+};
+}
diff --git a/source/d3d12/bc7_upload_v1.h b/source/d3d12/bc7_upload_v1.h
new file mode 100644
index 0000000..61a0d8e
--- /dev/null
+++ b/source/d3d12/bc7_upload_v1.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <stdint.h>
+
+// Optional exports scoped to the current copy_buffer_to_texture callback.
+// An eligible view is borrowed. The add-on must compare the source bytes and
+// retain the replacement upload resource while recorded GPU work can use it.
+enum rs_bc7_upload_status_v1 : uint32_t {
+    rs_bc7_upload_not_current = 0,
+    rs_bc7_upload_eligible = 1,
+    rs_bc7_upload_wrong_shape = 2,
+    rs_bc7_upload_partial = 3,
+    rs_bc7_upload_wrong_footprint = 4,
+    rs_bc7_upload_wrong_heap = 5,
+    rs_bc7_upload_bounds = 6,
+    rs_bc7_upload_unsupported_list = 7,
+};
+struct rs_bc7_upload_view_v1 {
+    uint32_t size, version, status, subresource;
+    uint32_t texture_width, texture_height, mip_count, texture_format;
+    uint32_t footprint_width, footprint_height, footprint_format, row_pitch;
+    uint32_t row_bytes, block_rows, reserved[2];
+    uint64_t token, source_resource, destination_resource, source_offset, source_span;
+};
+static_assert(sizeof(rs_bc7_upload_view_v1) == 104);
+struct rs_bc7_upload_replacement_v1 {
+    uint32_t size, version;
+    uint64_t token, upload_resource, upload_offset;
+};
+static_assert(sizeof(rs_bc7_upload_replacement_v1) == 32);
+// bool ReShadeD3D12QueryCanonicalBC7UploadV1(void *api_command_list,
+//     rs_bc7_upload_view_v1 *out);
+// bool ReShadeD3D12ReplaceCanonicalBC7UploadV1(void *api_command_list,
+//     const rs_bc7_upload_replacement_v1 *replacement);
+// Replace schedules the source for this call; the callback must return false
+// to let the native copy execute. It does not write source/target bytes.
diff --git a/source/d3d12/d3d12_bc7_upload.inl b/source/d3d12/d3d12_bc7_upload.inl
new file mode 100644
index 0000000..853573d
--- /dev/null
+++ b/source/d3d12/d3d12_bc7_upload.inl
@@ -0,0 +1,148 @@
+#include "bc7_upload_v1.h"
+#include <atomic>
+
+namespace reshade::d3d12::bc7_upload {
+
+bool IsBC7(DXGI_FORMAT f) {
+    return f == DXGI_FORMAT_BC7_TYPELESS || f == DXGI_FORMAT_BC7_UNORM || f == DXGI_FORMAT_BC7_UNORM_SRGB;
+}
+
+bool IsNativeUploadBuffer(ID3D12Resource *resource, uint64_t offset, uint64_t length) {
+    const auto desc = resource->GetDesc();
+    if (desc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER || desc.Layout != D3D12_TEXTURE_LAYOUT_ROW_MAJOR ||
+        offset % D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT || !length || offset > desc.Width || length > desc.Width - offset)
+        return false;
+    D3D12_HEAP_PROPERTIES heap = {};
+    return SUCCEEDED(resource->GetHeapProperties(&heap, nullptr)) && heap.Type == D3D12_HEAP_TYPE_UPLOAD;
+}
+
+struct Context {
+    reshade::api::command_list *api;
+    ID3D12Device *device;
+    ID3D12Device *device_proxy;
+    ID3D12GraphicsCommandList *native;
+    const D3D12_TEXTURE_COPY_LOCATION &dst;
+    const D3D12_TEXTURE_COPY_LOCATION &src;
+    const D3D12_BOX *src_box;
+    UINT x, y, z;
+    rs_bc7_upload_view_v1 view = {sizeof(view), 1};
+    bool checked = false;
+    ID3D12Resource *replacement = nullptr;
+    UINT64 replacement_offset = 0;
+};
+thread_local Context *current = nullptr;
+
+struct Scope {
+    Context &state;
+    Context *previous;
+    explicit Scope(Context &c) : state(c), previous(current) { current = &state; }
+    ~Scope() { current = previous; }
+};
+
+uint64_t NextToken() {
+    static std::atomic<uint64_t> sequence{1};
+    auto value = sequence.load(std::memory_order_relaxed);
+    while (value != UINT64_MAX)
+        if (sequence.compare_exchange_weak(value, value + 1, std::memory_order_relaxed)) return value;
+    return 0;
+}
+
+void Certify(Context &c) {
+    c.checked = true;
+    auto &v = c.view;
+    const auto type = c.native->GetType();
+    if (type != D3D12_COMMAND_LIST_TYPE_DIRECT && type != D3D12_COMMAND_LIST_TYPE_COPY) {
+        v.status = rs_bc7_upload_unsupported_list;
+        return;
+    }
+    const auto tex = c.dst.pResource->GetDesc();
+    const auto src_desc = c.src.pResource->GetDesc();
+    const UINT mip = c.dst.SubresourceIndex;
+    v.subresource = mip;
+    if (tex.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || tex.Width != 2048 || tex.Height != 2048 ||
+        tex.DepthOrArraySize != 1 || tex.MipLevels != 12 || tex.SampleDesc.Count != 1 || tex.SampleDesc.Quality != 0 ||
+        tex.Layout != D3D12_TEXTURE_LAYOUT_UNKNOWN || !IsBC7(tex.Format) || mip >= tex.MipLevels ||
+        src_desc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER || c.src.pResource == c.dst.pResource) {
+        v.status = rs_bc7_upload_wrong_shape;
+        return;
+    }
+    const UINT width = static_cast<UINT>(tex.Width) >> mip;
+    const UINT height = tex.Height >> mip;
+    const auto &placed = c.src.PlacedFootprint;
+    const auto &fp = placed.Footprint;
+    if (c.x || c.y || c.z || (c.src_box &&
+        (c.src_box->left || c.src_box->top || c.src_box->front || c.src_box->back != 1 ||
+         c.src_box->right != width || c.src_box->bottom != height))) {
+        v.status = rs_bc7_upload_partial;
+        return;
+    }
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT canonical = {};
+    UINT rows = 0;
+    UINT64 row_bytes = 0, bytes = 0;
+    c.device->GetCopyableFootprints(&tex, mip, 1, 0, &canonical, &rows, &row_bytes, &bytes);
+    if (!IsBC7(fp.Format) || fp.Width != canonical.Footprint.Width || fp.Height != canonical.Footprint.Height ||
+        fp.Depth != 1 || fp.RowPitch != canonical.Footprint.RowPitch || !rows || !row_bytes ||
+        row_bytes != ((width + 3) / 4) * 16u || rows != ((height + 3) / 4) ||
+        bytes != static_cast<UINT64>(rows - 1) * fp.RowPitch + row_bytes ||
+        placed.Offset % D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT) {
+        v.status = rs_bc7_upload_wrong_footprint;
+        return;
+    }
+    if (placed.Offset > src_desc.Width || bytes > src_desc.Width - placed.Offset) {
+        v.status = rs_bc7_upload_bounds;
+        return;
+    }
+    if (!IsNativeUploadBuffer(c.src.pResource, placed.Offset, bytes)) {
+        v.status = rs_bc7_upload_wrong_heap;
+        return;
+    }
+    v.token = NextToken();
+    if (!v.token) return;
+    v.status = rs_bc7_upload_eligible;
+    v.texture_width = static_cast<UINT>(tex.Width);
+    v.texture_height = tex.Height;
+    v.mip_count = tex.MipLevels;
+    v.texture_format = tex.Format;
+    v.footprint_width = fp.Width;
+    v.footprint_height = fp.Height;
+    v.footprint_format = fp.Format;
+    v.row_pitch = fp.RowPitch;
+    v.row_bytes = static_cast<UINT>(row_bytes);
+    v.block_rows = rows;
+    v.source_resource = reinterpret_cast<uint64_t>(c.src.pResource);
+    v.destination_resource = reinterpret_cast<uint64_t>(c.dst.pResource);
+    v.source_offset = placed.Offset;
+    v.source_span = bytes;
+}
+
+} // namespace reshade::d3d12::bc7_upload
+
+extern "C" __declspec(dllexport) bool ReShadeD3D12QueryCanonicalBC7UploadV1(void *api_command_list, rs_bc7_upload_view_v1 *out) {
+    using namespace reshade::d3d12::bc7_upload;
+    if (!api_command_list || !out || out->size != sizeof(*out) || out->version != 1) return false;
+    *out = {sizeof(*out), 1};
+    if (!current || current->api != api_command_list) return true;
+    if (!current->checked) Certify(*current);
+    *out = current->view;
+    return true;
+}
+
+extern "C" __declspec(dllexport) bool ReShadeD3D12ReplaceCanonicalBC7UploadV1(void *api_command_list,
+    const rs_bc7_upload_replacement_v1 *replacement) {
+    using namespace reshade::d3d12::bc7_upload;
+    auto *c = current;
+    if (!api_command_list || !replacement || replacement->size != sizeof(*replacement) || replacement->version != 1 ||
+        !c || c->api != api_command_list || !c->checked || c->view.status != rs_bc7_upload_eligible || c->replacement ||
+        replacement->token != c->view.token || !replacement->upload_resource) return false;
+    auto *res = reinterpret_cast<ID3D12Resource *>(replacement->upload_resource);
+    if (res == c->src.pResource || res == c->dst.pResource || !IsNativeUploadBuffer(res, replacement->upload_offset, c->view.source_span))
+        return false;
+    ID3D12Device *owner = nullptr;
+    if (FAILED(res->GetDevice(IID_PPV_ARGS(&owner))) || !owner) return false;
+    const bool same = owner == c->device || owner == c->device_proxy;
+    owner->Release();
+    if (!same) return false;
+    c->replacement = res;
+    c->replacement_offset = replacement->upload_offset;
+    return true;
+}
