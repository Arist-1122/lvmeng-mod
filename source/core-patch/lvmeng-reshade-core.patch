@@ -0,0 +1,43 @@
+#pragma once
+#include <stdint.h>
+// Additive C ABI. Native raw identities are borrowed, not COM weak references.
+enum rs_graphics_root_status_v1 : uint32_t {
+ rs_root_untracked=0,rs_root_complete=1,rs_root_partial=2,rs_root_busy=3,
+ rs_root_closed=4,rs_root_unsupported=5,rs_root_invalid=6,rs_root_destroyed=7
+};
+enum rs_graphics_root_parameter_kind_v1 : uint32_t {
+ rs_root_parameter_unknown=0,rs_root_parameter_table=1,rs_root_parameter_cbv=2,
+ rs_root_parameter_srv=3,rs_root_parameter_uav=4
+};
+struct rs_graphics_root_parameter_v1 {uint64_t value;uint32_t kind,reserved;};
+struct rs_graphics_root_snapshot_v1 {
+ uint32_t size,version,status,command_list_type;
+ uint64_t recording_generation,mutation_epoch,root_signature,root_signature_epoch,heap_epoch;
+ uint32_t root_signature_known,heap_known_mask;
+ uint64_t parameter_known_mask;
+ uint64_t native_heaps[2]; // Indexed by native D3D12 heap type: view=0, sampler=1.
+ uint64_t heap_gpu_starts[2];
+ uint32_t heap_descriptor_counts[2],heap_descriptor_increments[2];
+ rs_graphics_root_parameter_v1 parameters[64];
+};
+static_assert(sizeof(rs_graphics_root_parameter_v1)==16,"root parameter ABI");
+static_assert(sizeof(rs_graphics_root_snapshot_v1)==1144,"graphics root snapshot ABI");
+// bool __cdecl ReShadeD3D12QueryGraphicsRootStateV1(void *live_api_command_list,
+//    uint64_t required_parameter_mask,uint32_t required_heap_mask,
+//    rs_graphics_root_snapshot_v1 *out);
+// out.size=1144 and version=1; heap mask bits 0/1 only. false=bad arguments.
+// true=processed, inspect status. Complete requires a known root signature plus
+// the requested parameter/heap bits. Known null root/heap/value is represented
+// as zero and still must be rejected where a live binding is required.
+// Values mean table GPU descriptor handle or root CBV/SRV/UAV GPU VA by kind.
+// Root constants clear the affected parameter observation (unsupported kind).
+// Different root signature clears all params; redundant identical root keeps
+// them. Effective heap changes clear table params; redundant same heap set
+// preserves them regardless of input ordering. Reset/ClearState/Bundle/Indirect
+// conservatively clear observations. Bundles/internal immediate lists refuse.
+// A same-generation query is CPU call-return metadata, never GPU contents.
+// Caller serializes recording and independently checks resource/layout/heap
+// lifetime generations and table identity against current typed native heaps.
+// Heap GPU start/count/increment are observed on native SetDescriptorHeaps;
+// they allow bounded table-slot checks without dereferencing snapshot identities.
+// External get_native writers are outside the observed-call contract.
diff --git a/source/d3d12/ia_snapshot_v1.h b/source/d3d12/ia_snapshot_v1.h
new file mode 100644
index 0000000..743654e
--- /dev/null
+++ b/source/d3d12/ia_snapshot_v1.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <stdint.h>
+
+// Optional v4 fork extension, not exported by core v3. No API20 vtable edit.
+// Only CPU metadata from instrumented native/API calls is observed. No resource
+// ownership, native descriptor read, command submission or GPU completion proof.
+enum rs_ia_status_v1 : uint32_t {
+ rs_ia_untracked=0, rs_ia_complete=1, rs_ia_partial=2, rs_ia_busy=3,
+ rs_ia_closed=4, rs_ia_unsupported=5, rs_ia_invalid=6, rs_ia_destroyed=7
+};
+struct rs_vertex_buffer_view_v1 { uint64_t buffer_location; uint32_t size_bytes,stride_bytes; };
+struct rs_index_buffer_view_v1 { uint64_t buffer_location; uint32_t size_bytes,format; };
+struct rs_ia_snapshot_v1 {
+ uint32_t size,version,status,command_list_type;
+ uint64_t recording_generation,mutation_epoch;
+ uint32_t vertex_known_mask,index_known,index_present,reserved;
+ rs_vertex_buffer_view_v1 vertex[32];
+ rs_index_buffer_view_v1 index;
+};
+static_assert(sizeof(rs_vertex_buffer_view_v1)==16,"VBV wire size");
+static_assert(sizeof(rs_index_buffer_view_v1)==16,"IBV wire size");
+static_assert(sizeof(rs_ia_snapshot_v1)==576,"Snapshot wire size");
+struct rs_ia_binding_v1 {
+ uint32_t size,version,first_vertex_slot,vertex_count;
+ uint64_t expected_recording_generation;
+ uint32_t bind_index,index_present;
+ rs_vertex_buffer_view_v1 vertex[32];
+ rs_index_buffer_view_v1 index;
+};
+static_assert(sizeof(rs_ia_binding_v1)==560,"Exact binding wire size");
+// Proposed C export, __cdecl:
+// bool ReShadeD3D12QueryIASnapshotV1(void *api_command_list,
+//   uint32_t required_vertex_mask, uint32_t require_index,
+//   rs_ia_snapshot_v1 *out_snapshot);
+// Caller initializes size/version, passes a live D3D12 API command-list pointer,
+// and serializes recording on this list. require_index is 0 or 1.
+// false: bad arguments/size/version/API. true: processed; inspect status/masks.
+// Complete means all requested observed views are known, not all 32 necessarily.
+// Missing views are zero-filled and never guessed from resource Width-offset.
+// Index-known + !index-present means an explicitly observed null IB binding.
+// Snapshot generations/epochs must match the current recording. Native writes
+// bypassing the instrumented proxy/API path are outside this observed-state ABI.
+// Optional mutation export (unlike the metadata-only query):
+// bool ReShadeD3D12BindIAViewsV1(void *api_command_list,
+//   const rs_ia_binding_v1 *binding);
+// Requires exact nonzero recording generation and a supported, nonbusy list.
+// Calls native IASetVB/IB with exact values, updates this tracker, emits no addon
+// bind events. Caller owns all resources and serializes recording. Zero-count
+// with bind_index=0 is inert. index_present=0 binds a null native index view.
diff --git a/source/d3d12/ia_state_model.hpp b/source/d3d12/ia_state_model.hpp
