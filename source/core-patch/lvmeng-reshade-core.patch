+// The wrapper and API20 implementation both route every existing native graphics
+// root/heap call through these helpers. Queries never invoke COM or GPU methods.
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_signature(ID3D12RootSignature *signature)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::signature_write,reinterpret_cast<uint64_t>(signature));
+ _orig->SetGraphicsRootSignature(signature);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_descriptor_heaps(UINT count,ID3D12DescriptorHeap *const *objects)
+{
+ uint64_t identities[2]={},starts[2]={};uint32_t counts[2]={},increments[2]={},seen=0;
+ bool valid=count<=2&&(!count||objects);
+ auto *native_device=reinterpret_cast<ID3D12Device*>(_device->get_native());
+ for(UINT i=0;valid&&i<count;++i){
+  if(!objects[i]){valid=false;break;}
+  const auto desc=objects[i]->GetDesc();const auto type=static_cast<uint32_t>(desc.Type);
+  if(type>1||(seen&(1U<<type))||!(desc.Flags&D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE)){valid=false;break;}
+  seen|=1U<<type;identities[type]=reinterpret_cast<uint64_t>(objects[i]);starts[type]=objects[i]->GetGPUDescriptorHandleForHeapStart().ptr;
+  counts[type]=desc.NumDescriptors;increments[type]=native_device->GetDescriptorHandleIncrementSize(desc.Type);
+  if(!starts[type]||!counts[type]||!increments[type]||uint64_t(counts[type])*increments[type]>UINT64_MAX-starts[type])valid=false;
+ }
+ auto tx=_graphics_root_state.begin_heaps(identities,starts,counts,increments,valid);
+ _orig->SetDescriptorHeaps(count,objects);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_descriptor_table(UINT index,D3D12_GPU_DESCRIPTOR_HANDLE table)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,table.ptr,index,rs_root_parameter_table);
+ _orig->SetGraphicsRootDescriptorTable(index,table);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_constant_buffer_view(UINT index,D3D12_GPU_VIRTUAL_ADDRESS address)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,address,index,rs_root_parameter_cbv);
+ _orig->SetGraphicsRootConstantBufferView(index,address);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_shader_resource_view(UINT index,D3D12_GPU_VIRTUAL_ADDRESS address)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,address,index,rs_root_parameter_srv);
+ _orig->SetGraphicsRootShaderResourceView(index,address);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_unordered_access_view(UINT index,D3D12_GPU_VIRTUAL_ADDRESS address)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,address,index,rs_root_parameter_uav);
+ _orig->SetGraphicsRootUnorderedAccessView(index,address);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_32bit_constant(UINT index,UINT value,UINT offset)
+{
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,0,index,rs_root_parameter_unknown);
+ _orig->SetGraphicsRoot32BitConstant(index,value,offset);_graphics_root_state.finish(tx);
+}
+void reshade::d3d12::command_list_impl::observed_set_graphics_root_32bit_constants(UINT index,UINT count,const void *values,UINT offset)
+{
+ if(!count){_orig->SetGraphicsRoot32BitConstants(index,count,values,offset);return;}
+ auto tx=_graphics_root_state.begin(graphics_root_store::parameter_write,0,index,rs_root_parameter_unknown);
+ _orig->SetGraphicsRoot32BitConstants(index,count,values,offset);_graphics_root_state.finish(tx);
+}
+bool reshade::d3d12::command_list_impl::query_graphics_root_state(uint64_t parameters,uint32_t heaps,rs_graphics_root_snapshot_v1 *out) const
+{
+ return _graphics_root_state.query(parameters,heaps,out);
+}
+extern "C" __declspec(dllexport) bool ReShadeD3D12QueryGraphicsRootStateV1(void *api_command_list,uint64_t parameters,uint32_t heaps,rs_graphics_root_snapshot_v1 *out)
+{
