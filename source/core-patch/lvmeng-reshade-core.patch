+reshade::d3d12::descriptor_metadata_store::transaction reshade::d3d12::device_impl::metadata_begin_srv(ID3D12Resource *resource, const D3D12_SHADER_RESOURCE_VIEW_DESC *desc, D3D12_CPU_DESCRIPTOR_HANDLE dest, bool internal)
+{
+    rs_descriptor_metadata_v1 v = { sizeof(v), 1 };
+    v.kind = rs_descriptor_srv; v.resource_identity = reinterpret_cast<uint64_t>(resource);
+    v.status = rs_descriptor_unsupported;
