+#pragma once
+#include "graphics_root_snapshot_v1.h"
+#include <mutex>
+#include <cstring>
+
+namespace reshade::d3d12 {
+class graphics_root_store {
+ mutable std::mutex gate;
+ bool enabled=false,recording=false,destroyed=false,poisoned=false;
+ uint32_t type=0,active=0;uint64_t generation=0,epoch=0;
+ bool signature_known=false;uint64_t signature=0,signature_epoch=0,heap_epoch=0,known=0;
+ uint32_t heaps_known=0;
+ uint64_t heaps[2]={},starts[2]={};uint32_t counts[2]={},increments[2]={};
+ rs_graphics_root_parameter_v1 parameters[64]={};
+ void unknown(){signature_known=false;signature=signature_epoch=heap_epoch=known=0;heaps_known=0;std::memset(heaps,0,sizeof(heaps));std::memset(starts,0,sizeof(starts));std::memset(counts,0,sizeof(counts));std::memset(increments,0,sizeof(increments));std::memset(parameters,0,sizeof(parameters));}
+ bool advance(){if(epoch==UINT64_MAX){poisoned=true;unknown();return false;}++epoch;return true;}
+ void clear_tables(){for(unsigned i=0;i<64;++i)if(parameters[i].kind==rs_root_parameter_table){known&=~(uint64_t(1)<<i);parameters[i]={};}}
+public:
+ enum action:uint32_t {signature_write,heaps_write,parameter_write,make_unknown,reset};
+ struct operation {
+  graphics_root_store *owner=nullptr;action what=make_unknown;uint64_t generation=0,token=0,value=0;
+  uint32_t index=0,kind=0;uint64_t heaps[2]={},starts[2]={};uint32_t counts[2]={},increments[2]={};
+  operation()=default;operation(const operation&)=delete;operation&operator=(const operation&)=delete;
+  operation(operation&&o)noexcept:owner(o.owner),what(o.what),generation(o.generation),token(o.token),value(o.value),index(o.index),kind(o.kind){std::memcpy(heaps,o.heaps,sizeof(heaps));std::memcpy(starts,o.starts,sizeof(starts));std::memcpy(counts,o.counts,sizeof(counts));std::memcpy(increments,o.increments,sizeof(increments));o.owner=nullptr;}
+  ~operation(){if(owner)owner->finish(*this,false);}bool started()const{return owner!=nullptr;}
+ };
+ void enable(uint32_t list_type,uint64_t gen,bool initially_recording=true){std::lock_guard<std::mutex>l(gate);type=list_type;enabled=list_type==0&&gen;recording=enabled&&initially_recording;generation=gen;advance();unknown();}
+ operation begin(action what,uint64_t value=0,uint32_t index=0,uint32_t kind=0){
+  std::lock_guard<std::mutex>l(gate);operation tx;if(!enabled||destroyed||!recording)return tx;
+  if(what==parameter_write&&(index>=64||kind>rs_root_parameter_uav)){poisoned=true;unknown();advance();return tx;}
+  if(active){poisoned=true;unknown();}if(!advance())return tx;
+  tx.owner=this;tx.what=what;tx.generation=generation;tx.token=epoch;tx.value=value;tx.index=index;tx.kind=kind;++active;return tx;
+ }
+ operation begin_reset(uint64_t gen){std::lock_guard<std::mutex>l(gate);operation tx;if(!enabled||destroyed)return tx;bool overlap=active!=0;recording=false;unknown();poisoned=overlap||!gen;generation=gen;if(!advance())return tx;tx.owner=this;tx.what=reset;tx.generation=gen;tx.token=epoch;++active;return tx;}
+ operation begin_heaps(const uint64_t (&identities)[2],const uint64_t (&gpu_starts)[2],const uint32_t (&descriptor_counts)[2],const uint32_t (&descriptor_increments)[2],bool valid=true){
+  auto tx=begin(heaps_write);if(!tx.started())return tx;
+  if(!valid){std::lock_guard<std::mutex>l(gate);poisoned=true;unknown();return tx;}
+  std::memcpy(tx.heaps,identities,sizeof(tx.heaps));std::memcpy(tx.starts,gpu_starts,sizeof(tx.starts));std::memcpy(tx.counts,descriptor_counts,sizeof(tx.counts));std::memcpy(tx.increments,descriptor_increments,sizeof(tx.increments));return tx;
+ }
+ bool finish(operation &tx,bool returned=true){
+  std::lock_guard<std::mutex>l(gate);if(tx.owner!=this)return false;
+  const bool same=tx.generation==generation;const bool commit=returned&&same&&!destroyed&&!poisoned&&active==1&&tx.token==epoch;
+  if(same){
+   if(tx.what==reset){recording=commit;unknown();}
+   else if(!commit){unknown();if(active>1)poisoned=true;}
+   else switch(tx.what){
+    case signature_write:
+     if(!signature_known||signature!=tx.value){known=0;std::memset(parameters,0,sizeof(parameters));signature_epoch=tx.token;}
+     signature=tx.value;signature_known=true;break;
+    case heaps_write:{
+     bool changed=heaps_known!=3||std::memcmp(heaps,tx.heaps,sizeof(heaps))||std::memcmp(starts,tx.starts,sizeof(starts))||std::memcmp(counts,tx.counts,sizeof(counts))||std::memcmp(increments,tx.increments,sizeof(increments));
+     if(changed){clear_tables();heap_epoch=tx.token;}
+     std::memcpy(heaps,tx.heaps,sizeof(heaps));std::memcpy(starts,tx.starts,sizeof(starts));std::memcpy(counts,tx.counts,sizeof(counts));std::memcpy(increments,tx.increments,sizeof(increments));heaps_known=3;break;
+    }
+    case parameter_write:
+     parameters[tx.index]={};known&=~(uint64_t(1)<<tx.index);
+     if(tx.kind){parameters[tx.index]={tx.value,tx.kind,0};known|=uint64_t(1)<<tx.index;}break;
+    case make_unknown:unknown();break;
+    default:break;
+   }
+  }
+  advance();if(active)--active;tx.owner=nullptr;return commit;
+ }
+ void close(){std::lock_guard<std::mutex>l(gate);recording=false;unknown();advance();}
+ void destroy(){std::lock_guard<std::mutex>l(gate);destroyed=true;recording=false;unknown();advance();}
+ bool query(uint64_t required,uint32_t required_heaps,rs_graphics_root_snapshot_v1*out)const{
+  if(!out||out->size!=sizeof(*out)||out->version!=1||(required_heaps&~3U))return false;
+  std::lock_guard<std::mutex>l(gate);rs_graphics_root_snapshot_v1 r={};r.size=sizeof(r);r.version=1;r.command_list_type=type;r.recording_generation=generation;r.mutation_epoch=epoch;
+  if(!enabled)r.status=rs_root_unsupported;else if(destroyed)r.status=rs_root_destroyed;else if(active)r.status=rs_root_busy;else if(!recording)r.status=rs_root_closed;else if(poisoned)r.status=rs_root_invalid;
