+        if (!resource && desc->ViewDimension != D3D12_SRV_DIMENSION_RAYTRACING_ACCELERATION_STRUCTURE) v.status = rs_descriptor_null;
+        else if (resource && desc->ViewDimension == D3D12_SRV_DIMENSION_TEXTURE2D) {
+            // Identity/presence only: this ABI intentionally exposes no mip,
+            // plane, sample, dimension extent or texture byte-range proof.
+            // Ask the native device about this explicit typed sampling format;
+            // no GPU work or resource read is performed here.
+            const auto resource_desc = resource->GetDesc();
+            D3D12_FEATURE_DATA_FORMAT_SUPPORT support = { desc->Format };
+            if (resource_desc.Dimension == D3D12_RESOURCE_DIMENSION_TEXTURE2D &&
+                desc->Format != DXGI_FORMAT_UNKNOWN &&
+                SUCCEEDED(_orig->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &support, sizeof(support))) &&
+                (support.Support1 & D3D12_FORMAT_SUPPORT1_TEXTURE2D) &&
+                (support.Support1 & D3D12_FORMAT_SUPPORT1_SHADER_SAMPLE))
+                v.status = rs_descriptor_known;
+        }
+        else if (resource && desc->ViewDimension == D3D12_SRV_DIMENSION_BUFFER && desc->Format == DXGI_FORMAT_UNKNOWN && desc->Buffer.StructureByteStride && desc->Buffer.Flags == D3D12_BUFFER_SRV_FLAG_NONE) {
