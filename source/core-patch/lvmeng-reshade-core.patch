@@ -0,0 +1,218 @@
+#pragma once
+#include "descriptor_metadata_v1.h"
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <utility>
+
+namespace reshade::d3d12
+{
+// The core disables exceptions. Storage is fixed, explicitly nothrow, never
+// resized; tombstones may be reused but no live record is silently evicted.
+template <typename T> class metadata_bounded_map
+{
+    struct node { uint64_t key=0; T value={}; uint8_t state=0; };
+    std::unique_ptr<node[]> _nodes; size_t _length=0,_limit=0,_count=0;
+    static uint64_t mix(uint64_t x) noexcept {x^=x>>30;x*=0xbf58476d1ce4e5b9ull;x^=x>>27;x*=0x94d049bb133111ebull;return x^(x>>31);}
+public:
+    bool initialize(size_t limit) noexcept {if(!limit||limit>262144)return false;_length=2;while(_length<limit*2)_length<<=1;_limit=limit;_nodes.reset(new(std::nothrow)node[_length]);return bool(_nodes);}
+    T *find(uint64_t key) noexcept
+    {
+        if(!_nodes)return nullptr;
+        for(size_t n=0,i=size_t(mix(key))&(_length-1);n<_length;++n,i=(i+1)&(_length-1)){auto &s=_nodes[i];if(!s.state)return nullptr;if(s.state==1&&s.key==key)return &s.value;}return nullptr;
+    }
+    const T *find(uint64_t key) const noexcept {return const_cast<metadata_bounded_map *>(this)->find(key);}
+    bool put(uint64_t key,const T &value) noexcept
+    {
+        if(auto p=find(key)){*p=value;return true;}if(!_nodes||_count>=_limit)return false;
+        for(size_t n=0,i=size_t(mix(key))&(_length-1);n<_length;++n,i=(i+1)&(_length-1)){auto &s=_nodes[i];if(s.state==1)continue;s.key=key;s.value=value;s.state=1;++_count;return true;}return false;
+    }
+    bool erase(uint64_t key) noexcept
+    {
+        if(!_nodes)return false;
+        for(size_t n=0,i=size_t(mix(key))&(_length-1);n<_length;++n,i=(i+1)&(_length-1)){auto &s=_nodes[i];if(!s.state)return false;if(s.state==1&&s.key==key){s.state=2;s.value={};--_count;return true;}}return false;
+    }
+    template<typename F> void each(F &&f) noexcept {if(_nodes)for(size_t i=0;i<_length;++i)if(_nodes[i].state==1)f(_nodes[i].key,_nodes[i].value);}
+    template<typename F> void each(F &&f) const noexcept {if(_nodes)for(size_t i=0;i<_length;++i)if(_nodes[i].state==1)f(_nodes[i].key,_nodes[i].value);}
+    template<typename F> void erase_if(F &&f) noexcept {if(_nodes)for(size_t i=0;i<_length;++i)if(_nodes[i].state==1&&f(_nodes[i].key,_nodes[i].value)){_nodes[i].state=2;_nodes[i].value={};--_count;}}
+    size_t storage_bytes() const noexcept {return _nodes?_length*sizeof(node):0;}
+};
+
+// Independent of API20 legacy _views. No native call, addon callback or native
+// pointer dereference occurs under the mutex. A transaction depends on its
+// destination slots, captured copy sources, and resource/heap lifetimes.
+class descriptor_metadata_store
+{
