+    uint64_t total_d = 0, total_s = 0;
+    for (UINT i = 0; i < nd; ++i) total_d += ds ? ds[i] : 1;
+    for (UINT i = 0; i < ns; ++i) total_s += ss ? ss[i] : 1;
+    if (total_d != total_s || total_d > 4096) { _descriptor_metadata.fail_closed(); return {}; }
