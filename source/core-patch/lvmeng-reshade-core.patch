+            if (desc->Buffer.FirstElement <= UINT64_MAX / v.stride) {
+                v.offset_bytes = desc->Buffer.FirstElement * v.stride; v.range_bytes = v.element_count * v.stride; v.status = rs_descriptor_known;
+            } else v.status = rs_descriptor_invalid;
+        }
+    }
+    return _descriptor_metadata.begin_write(dest.ptr, v, internal);
+}
